---
import { site } from '../data/site';
import { type Lang, t } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="certs" aria-labelledby="certs-title">
  <div class="label">
    <h2 id="certs-title">{ui[lang].certificates}</h2>
    <p>{ui[lang].certificatesLead}</p>
  </div>
  <ul>
    {
      site.certificates.map((cert) => (
        <li>
          <a class="cert" href={cert.url} target="_blank" rel="noopener noreferrer">
            <span class="top">
              <span class="seal">
                <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
                  <circle cx="20" cy="20" r="19" fill="#1ba94c" />
                  <circle cx="20" cy="20" r="15" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="1.5 2.5" />
                  <path d="m13.5 20.5 4.5 4.5 9-9.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {ui[lang].verified}
              </span>
              <span class="date">{t(cert.date, lang)}</span>
            </span>
            <span class="issuer">
              {cert.issuer} · {ui[lang].skillCertificate}
            </span>
            <span class="name">{cert.name}</span>
            <span class="topics">{t(cert.topics, lang)}</span>
            <span class="verify">
              {ui[lang].verify}
              <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5"></path>
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Proje satırlarıyla aynı düzen: solda başlık sütunu, sağda kartlar. */
  .certs {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    column-gap: 36px;
    align-items: start;
    padding: 0 var(--page-gutter) 136px;
  }

  h2 {
    margin-bottom: 16px;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .label p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 24px;
    max-width: 820px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  @media (width <= 1100px) {
    .certs {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    ul {
      margin: 0;
    }
  }

  .cert {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 28px 26px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(27 169 76 / 0.07), transparent 55%),
      var(--surface);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 36px;
  }

  .seal {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #128a3c;
    font-size: 14px;
    font-weight: 500;
  }

  .date {
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .issuer {
    color: var(--muted);
    font-size: 14px;
  }

  .name {
    margin-top: 6px;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .topics {
    margin-top: 14px;
    color: #4f4c57;
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .verify {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 28px;
    font-size: 14px;
  }

  .verify svg {
    transition: transform 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cert:hover {
      border-color: transparent;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.04),
        0 24px 48px -24px rgb(0 0 0 / 0.22);
      transform: translateY(-4px) rotate(-0.6deg);
    }

    .cert:hover .verify svg {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert,
    .verify svg {
      transition: none;
    }

    .cert:hover {
      transform: none;
    }
  }

  @media (width <= 700px) {
    .certs {
      padding: 0 24px 56px;
    }

    .certs {
      row-gap: 24px;
    }

    h2 {
      margin-bottom: 12px;
      font-size: 32px;
    }

    .cert {
      padding: 24px 22px 22px;
    }

    .name {
      font-size: 30px;
    }
  }
</style>
