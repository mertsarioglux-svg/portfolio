---
import { site } from '../data/site';
import { type Lang, t } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { about } = site;
---

<dialog id="about" class="about" aria-labelledby="about-title">
  <div class="panel">
    <header>
      <h2 id="about-title">{ui[lang].aboutTitle}</h2>
      <button type="button" class="close" aria-label={ui[lang].close} data-close-about autofocus>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>
    <div class="bio">
      {about.bio[lang].map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="portrait">
      <img src={about.portrait.src} alt={t(about.portrait.alt, lang)} width="1200" height="800" loading="lazy" decoding="async" />
    </div>
    <section aria-labelledby="about-certs">
      <h3 id="about-certs">{ui[lang].certificates}</h3>
      <ul class="certs">
        {
          site.certificates.map((cert) => (
            <li>
              <a href={cert.url} target="_blank" rel="noopener noreferrer">
                <span class="year">{cert.year}</span>
                <span class="cert-name">{cert.name}</span>
                <span class="issuer">
                  {cert.issuer}
                  <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 11 11 5M6 5h5v5"></path>
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</dialog>

<script>
  import '../scripts/about';
</script>

<style>
  .about {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    transition: background 0.4s;
  }

  .about:global(.shown) {
    background: rgb(0 0 0 / 0.12);
  }

  .about::backdrop {
    background: transparent;
  }

  .panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vh, 48px);
    width: min(520px, 100vw);
    padding: clamp(32px, 5vh, 56px) 56px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    font-weight: 400;
    transform: translateX(-100%);
    transition: transform 0.45s var(--ease-out);
  }

  .about:global(.shown) .panel {
    transform: none;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: -8px;
  }

  h2 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: 2px -8px 0 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s;
  }

  .close:hover {
    background: #f2f1f4;
  }

  .close:focus-visible {
    outline-offset: 2px;
  }

  .bio p {
    color: #5b5864;
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .bio p + p {
    margin-top: 16px;
  }

  .portrait {
    flex: 0 0 auto;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 2px 8px rgb(0 0 0 / 0.03);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 500;
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs a {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #eceaf0;
    font-size: 15px;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .year,
  .issuer {
    color: var(--muted);
  }

  .year {
    font-variant-numeric: tabular-nums;
  }

  .issuer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .certs a:hover .cert-name {
    color: var(--accent);
  }

  @media (width <= 600px) {
    .panel {
      gap: 28px;
      padding: 28px 24px 40px;
    }

    h2 {
      font-size: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about,
    .panel {
      transition: none;
    }
  }
</style>
