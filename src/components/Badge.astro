---
import { site } from '../data/site';
import { type Lang, t } from '../i18n/lang';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Hem 3D kartın üstüne basılan yazılar hem de mobildeki düz kart bu veriden çizilir.
const card = {
  first: site.firstName,
  last: site.lastName,
  currentLabel: ui[lang].badgeCurrent,
  current: t(site.badge.current, lang),
  tagsLabel: ui[lang].badgeTags,
  tags: site.badge.tags,
  back: ui[lang].badgeBack,
  lang,
};
---

<div class="badge" data-badge data-card={JSON.stringify(card)}>
  <div class="still" aria-hidden="true">
    <div class="sleeve">
      <span class="hole hole-l"></span>
      <span class="slot"></span>
      <span class="hole hole-r"></span>
      <span class="seal"></span>
      <div class="paper">
        <p class="card-name"><span>{card.first}</span><span class="hl">{card.last}</span></p>
        <div class="card-meta">
          <p class="card-label">{card.currentLabel}</p>
          <p class="card-current">{card.current}</p>
          <p class="card-label">{card.tagsLabel}</p>
          <p class="card-tags">
            {card.tags.map((tag) => <span style={`--c:${tag.color};--t:${tag.text}`}>{tag.label}</span>)}
          </p>
        </div>
      </div>
    </div>
  </div>
  <canvas class="stage" role="img" aria-label={ui[lang].badgeLabel}></canvas>
</div>

<script>
  import { startBadge } from '../scripts/badge/loader';

  startBadge();
</script>

<style>
  .badge {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .stage {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    touch-action: pan-y;
    transition: opacity 0.6s ease;
  }

  .badge.is-live .stage {
    opacity: 1;
  }

  /* Düz kart: mobilde her zaman, masaüstünde yalnızca 3D açılamazsa görünür. */
  .still {
    display: none;
    position: absolute;
    inset: 26vh 0 14vh;
    justify-content: center;
    align-items: center;
    container-type: size;
    pointer-events: none;
    filter: drop-shadow(14px 22px 10px rgb(0 0 0 / 0.1));
  }

  .badge.is-fallback .still {
    display: flex;
  }

  .badge.is-fallback .stage {
    display: none;
  }

  .sleeve {
    --tilt: 4deg;

    position: relative;
    width: min(84cqw, 100cqh * 172 / 272);
    aspect-ratio: 172 / 272;
    container-type: inline-size;
    border: 0.5cqw solid rgb(176 184 192 / 0.55);
    border-radius: 5.8cqw;
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / 0.65) 42%, rgb(255 255 255 / 0) 54%),
      rgb(226 231 236 / 0.55);
    box-shadow:
      inset 0 0 0 0.4cqw rgb(255 255 255 / 0.7),
      inset 0 -1cqw 2cqw rgb(120 130 140 / 0.12);
    transform: rotate(var(--tilt));
  }

  .hole,
  .slot {
    position: absolute;
    top: 7.7%;
    border: 0.45cqw solid rgb(150 158 166 / 0.6);
    background: var(--surface);
    translate: 0 -50%;
  }

  .hole {
    width: 8.7cqw;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .hole-l {
    left: calc(14% - 4.35cqw);
  }

  .hole-r {
    right: calc(14% - 4.35cqw);
  }

  .slot {
    left: 37.8%;
    width: 24.4%;
    height: 5.2cqw;
    border-radius: 999px;
  }

  .seal {
    position: absolute;
    top: 15.8%;
    left: 0;
    right: 0;
    height: 0.8cqw;
    border-top: 1px solid rgb(0 0 0 / 0.1);
    border-bottom: 1px solid rgb(255 255 255 / 0.8);
  }

  .paper {
    position: absolute;
    top: 19.5%;
    right: 6.4%;
    bottom: 4%;
    left: 6.4%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7.3cqw;
    border-radius: 0.6cqw;
    background: #f6f5f1;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.04);
    color: var(--ink);
  }

  .card-name {
    font-size: 15.6cqw;
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.02em;
  }

  .card-name span {
    display: block;
    width: max-content;
  }

  .hl {
    color: var(--accent);
  }

  .card-meta {
    font-size: 2.9cqw;
    line-height: 1.3;
  }

  .card-label {
    font-style: italic;
    color: #3d3c42;
  }

  .card-current {
    margin: 0.4em 0 1.1em;
    color: #3d3c42;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1cqw;
    margin-top: 0.5em;
  }

  .card-tags span {
    padding: 0.3em 0.75em 0.4em;
    border-radius: 999px;
    background: var(--c);
    color: var(--t, #fff);
    font-weight: 500;
  }

  @media (width <= 700px) {
    .stage {
      display: none;
    }

    .still {
      display: flex;
      inset: 168px 16px calc(var(--name-size-mobile) * 2 * 0.88 + 36px);
    }

    .sleeve {
      --tilt: 7deg;

      translate: 0 4%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage {
      transition: none;
    }
  }
</style>
