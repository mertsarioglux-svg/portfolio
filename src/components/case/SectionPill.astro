---
import type { Lang } from '../../i18n/lang';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
  sections: { slug: string; text: string }[];
}

const { lang, sections } = Astro.props;
const number = (i: number) => String(i).padStart(2, '0');
---

<div class="section-pill" data-section-pill>
  <ol class="list" id="section-list" hidden>
    {
      sections.map((section, i) => (
        <li>
          <a href={`#${section.slug}`} data-index={i}>
            <span class="dot" aria-hidden="true" />
            <span class="num">{number(i)}</span>
            {section.text}
          </a>
        </li>
      ))
    }
  </ol>
  <button type="button" class="current" aria-expanded="false" aria-controls="section-list" aria-label={ui[lang].showSections}>
    <span class="num" data-num>00</span>
    <span class="label" data-label>{sections[0]?.text}</span>
    <span class="bar" aria-hidden="true"><span data-progress></span></span>
    <svg class="chevron" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m4 10 4-4 4 4"></path>
    </svg>
  </button>
</div>

<script>
  // Alttaki hap: okunan bölümü ve ilerlemeyi gösterir; tıklanınca bölüm listesi açılır.
  const pill = document.querySelector<HTMLElement>('[data-section-pill]');
  const list = pill?.querySelector<HTMLOListElement>('.list');
  const button = pill?.querySelector<HTMLButtonElement>('.current');

  if (pill && list && button) {
    const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const num = pill.querySelector<HTMLElement>('[data-num]')!;
    const label = pill.querySelector<HTMLElement>('[data-label]')!;
    const progress = pill.querySelector<HTMLElement>('[data-progress]')!;
    const hero = document.querySelector<HTMLElement>('.project-hero');
    const end = document.querySelector<HTMLElement>('.next');
    let frame = 0;

    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.4;
      let current = 0;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top < line) current = i;
      });
      num.textContent = String(current).padStart(2, '0');
      label.textContent = links[current].textContent?.replace(/^\s*\d+\s*/, '').trim() ?? '';
      links.forEach((link, i) => {
        link.classList.toggle('done', i < current);
        link.classList.toggle('active', i === current);
      });
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      // Giriş bölümü geçilince görünür, "Sonraki proje" bölümüne gelince gizlenir.
      const afterHero = !hero || hero.getBoundingClientRect().bottom < window.innerHeight * 0.5;
      const beforeEnd = !end || end.getBoundingClientRect().top > window.innerHeight * 0.85;
      const visible = afterHero && beforeEnd;
      pill.classList.toggle('visible', visible);
      if (!visible) setOpen(false);
    };

    const setOpen = (open: boolean) => {
      list.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      pill.classList.toggle('open', open);
    };

    window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    window.addEventListener('wheel', () => setOpen(false), { passive: true });
    window.addEventListener('touchmove', () => setOpen(false), { passive: true });
    window.addEventListener('resize', () => (frame ||= requestAnimationFrame(update)));
    button.addEventListener('click', () => setOpen(!pill.classList.contains('open')));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !list.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!list.hidden && !pill.contains(event.target as Node)) setOpen(false);
    });
    update();
  }
</script>

<style>
  .section-pill {
    position: fixed;
    bottom: 20px;
    left: 50%;
    z-index: 40;
    color: #fff;
    font-size: 14px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 16px);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out);
  }

  .section-pill:global(.visible) {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .current {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 260px;
    max-width: min(420px, calc(100vw - 32px));
    padding: 12px 16px;
    border: 0;
    border-radius: 999px;
    background: #0e0e10;
    color: inherit;
    cursor: pointer;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }

  .num {
    color: rgb(255 255 255 / 0.55);
    font-variant-numeric: tabular-nums;
  }

  .label {
    flex: 1;
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar {
    width: 48px;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.2);
  }

  .bar span {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .chevron {
    transition: transform 0.2s;
  }

  .section-pill:global(.open) .chevron {
    transform: rotate(180deg);
  }

  .list {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    width: max(100%, 280px);
    margin: 0;
    padding: 14px 10px;
    border-radius: 18px;
    background: #0e0e10;
    list-style: none;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }

  .list a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    color: rgb(255 255 255 / 0.6);
    transition:
      background 0.15s,
      color 0.15s;
  }

  .list a:hover {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }

  .list a:global(.active) {
    color: #fff;
  }

  .dot {
    width: 9px;
    height: 9px;
    border: 1.5px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
  }

  .list a:global(.done) .dot,
  .list a:global(.active) .dot {
    border-color: #fff;
    background: #fff;
  }

  .list li + li .dot::before {
    content: '';
    position: absolute;
    left: 14px;
    top: -9px;
    height: 18px;
    border-left: 1.5px solid rgb(255 255 255 / 0.25);
  }

  .current:focus-visible,
  .list a:focus-visible {
    outline-color: #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-pill,
    .chevron {
      transition: none;
    }
  }
</style>
