---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** "Başlık · açıklama" biçiminde; noktadan önceki kısım kalın yazılır. */
  caption: string;
  alt?: string;
}

const { src, caption, alt } = Astro.props;
const [lead, ...rest] = caption.split(' · ');
---

<figure class="figure">
  <Image src={src} alt={alt ?? caption} widths={[800, 1200, 1600, 2000]} sizes="(min-width: 1140px) 1040px, 92vw" />
  <figcaption><strong>{lead}</strong>{rest.length > 0 && <> · {rest.join(' · ')}</>}</figcaption>
</figure>

<style>
  .figure {
    position: relative;
    left: 50%;
    width: min(1040px, 92vw);
    margin: 56px 0;
    transform: translateX(-50%);
  }

  .figure :global(img) {
    width: 100%;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 24px 48px -32px rgb(0 0 0 / 0.25);
  }

  figcaption {
    max-width: 600px;
    margin: 16px auto 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  strong {
    color: var(--ink);
    font-weight: 500;
  }
</style>
