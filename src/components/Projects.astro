---
import { Image } from 'astro:assets';
import { type Lang, projectPath } from '../i18n/lang';
import { ui } from '../i18n/ui';
import { getProjects, slugOf } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
---

<section id="work" class="work" aria-label={ui[lang].workLabel}>
  {
    projects.map((project) => (
      <a class="project" href={projectPath(lang, slugOf(project))} style={`--n:${project.data.previews.length}`}>
        <div class="label">
          <div class="copy">
            <h2>{project.data.title}</h2>
            <p>{project.data.summary}</p>
            <p class="date">{project.data.date}</p>
          </div>
        </div>
        <div class="previews" aria-hidden="true">
          {project.data.previews.map((src, i) => (
            <Image
              class="preview"
              src={src}
              alt=""
              widths={[500, 900]}
              sizes="(max-width: 700px) 92vw, 250px"
              loading="lazy"
              style={`--i:${i}`}
            />
          ))}
        </div>
      </a>
    ))
  }
</section>

<script>
  import '../scripts/projects';
</script>

<style>
  .work {
    padding: 104px 0 136px;
    scroll-margin-top: 48px;
    overflow: clip;
  }

  .project {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 280px;
    padding: 40px var(--page-gutter);
    border-top: 1px solid var(--line);
    isolation: isolate;
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface);
    opacity: 0;
    transition: opacity 0.18s;
  }

  .project:global(.active) {
    z-index: 10;
  }

  .project:global(.active)::before {
    opacity: 1;
  }

  .project:focus-visible {
    outline-offset: -5px;
  }

  .label {
    width: 360px;
    max-width: 100%;
  }

  .copy {
    padding: 8px 0;
    transition:
      opacity 0.18s,
      filter 0.18s;
  }

  .project:global(.muted) .copy {
    opacity: 0.35;
    filter: blur(4px);
  }

  h2 {
    margin-bottom: 16px;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  p {
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  p + p {
    margin-top: 12px;
  }

  .date {
    opacity: 0.5;
  }

  .previews {
    position: absolute;
    top: 50%;
    right: var(--page-gutter);
    left: calc(var(--page-gutter) + 396px);
    z-index: 20;
    height: 190px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .previews :global(.preview) {
    --step: max(0px, min(225px, 50% - 125px));
    --r: -8deg;

    position: absolute;
    top: 0;
    right: calc((var(--n) - 1 - var(--i)) * var(--step));
    width: 250px;
    height: 190px;
    object-fit: cover;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 4px;
    background: #fff padding-box;
    opacity: 0;
    transform: translateY(64px) rotate(0) scale(0.95);
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.16s ease;
  }

  .previews :global(.preview:nth-child(2)) {
    --r: 10deg;

    top: 8px;
  }

  .previews :global(.preview:nth-child(3)) {
    --r: -7.2deg;

    top: 8px;
  }

  .project:global(.active) .previews :global(.preview) {
    opacity: 1;
    transform: translateY(0) rotate(var(--r));
  }

  .project:global(.active) .previews :global(.preview:nth-child(2)) {
    transition-delay: 35ms;
  }

  .project:global(.active) .previews :global(.preview:nth-child(3)) {
    transition-delay: 70ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .previews :global(.preview) {
      transform: none !important;
      transition: opacity 0.16s;
    }

    .project:global(.active) .previews :global(.preview) {
      transition-delay: 0s !important;
    }
  }

  @media (width <= 700px) {
    .work {
      padding: 48px 0 56px;
    }

    .project {
      display: block;
      min-height: 0;
      padding: 32px 24px;
    }

    .label {
      width: 100%;
    }

    .project:global(.muted) .copy {
      opacity: 1;
      filter: none;
    }

    h2 {
      margin-bottom: 12px;
      font-size: 32px;
    }

    .previews {
      position: relative;
      inset: auto;
      z-index: auto;
      height: auto;
      margin-top: 24px;
      transform: none;
    }

    .previews :global(.preview) {
      position: static;
      display: none;
      width: 100%;
      height: auto;
      aspect-ratio: 890 / 676;
      opacity: 1;
      transform: none !important;
      transition: none;
    }

    .previews :global(.preview:first-child) {
      display: block;
    }
  }
</style>
