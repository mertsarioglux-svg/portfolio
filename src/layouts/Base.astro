---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import { type Lang, homePath, languages } from '../i18n/lang';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Bu sayfanın her dildeki adresi (hreflang için). Verilmezse ana sayfa. */
  paths?: Record<Lang, string>;
  image?: string;
}

const { lang, title, description, paths = homePath, image } = Astro.props;
const canonical = new URL(paths[lang], Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(paths[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(paths.tr, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <slot />
  </body>
</html>
